# Shell — set per host. Uncomment on macOS to use the wrapper that strips the
# trailing-slash PWD nushell rejects. On Linux just rely on $SHELL (nu).
# command = /Users/user/bin/nu-pwd-fix

# xterm-256color is available system-wide (no sudo terminfo issues)
term = xterm-256color

font-size = 12
font-family = CommitMono Nerd Font

background = #202733
foreground = #dce6f2

cursor-color = #dce6f2
cursor-text = #202733

selection-background = #3b4558
selection-foreground = #ffffff

# macOS-only (ignored on Linux, will warn). Uncomment on macOS hosts.
# window-colorspace = display-p3

# Brighter Apple-Terminal-ish ANSI palette
palette = 0=#52677a
palette = 1=#d66b61
palette = 2=#7edc8b
palette = 3=#f0c674
palette = 4=#69c3ff
palette = 5=#c792ea
palette = 6=#8be9fd
palette = 7=#dce6f2
palette = 8=#6b8094
palette = 9=#ff7b72
palette = 10=#a6e3a1
palette = 11=#ffd866
palette = 12=#7dcfff
palette = 13=#d2a6ff
palette = 14=#b4f9f8
palette = 15=#ffffff

# ─── Keybindings (Linux-tuned, coordinated with silakka54-linux.vil) ─────────
# Cinnamon uses Super for window management. The keyboard's left thumb sends
# KC_LGUI (Super), so Super reaches Cinnamon directly — no conflicts here.
# Clipboard chords on Layer 1 of the keyboard send Ctrl+Z/X/C/V/S (Linux
# app-level), so terminal copy/paste stays on Ghostty's Ctrl+Shift+C/V.

# Tabs
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4

# Splits — tmux-style (Ctrl+Shift+ prefix to avoid clashing with shell chords)
keybind = ctrl+shift+o=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+down=goto_split:down
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+shift+enter=toggle_split_zoom

# Window / fullscreen
keybind = f11=toggle_fullscreen

# Clipboard (Ctrl+Shift so the shell still gets Ctrl+C for SIGINT)
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Font
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Reload config without restart
keybind = ctrl+shift+comma=reload_config
